{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 16, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "ASan + 单测 + bench，日常开发用",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CORNET_ENABLE_BENCH": "ON",
        "CORNET_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "发布构建；配合 -DCORNET_ENABLE_BENCH=ON 出 bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "profile",
      "inherits": "base",
      "displayName": "Profile",
      "description": "保留帧指针+调试符号, 供 tools/profile.sh 使用",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CORNET_ENABLE_BENCH": "ON",
        "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-rdynamic"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
